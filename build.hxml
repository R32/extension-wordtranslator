-cp src
-dce full
-D js-es=6
-D js-global=window
-D analyzer-optimize
-D message.reporting=classic
-D no-traces

-lib chrome-extension-v3
-lib macro-aux
-lib no-vdom
--macro exclude('haxe.iterators.ArrayIterator')

--each
-D js-global=globalThis
-main Background
--js build/js/background.js
--macro maux.ModuleLevel.strip(['Background'])

--next
-main ContentScript
--js build/js/content-script.js

--next
-main HookMain
--js build/js/hook-main.js
--macro maux.ModuleLevel.strip(['HookMain'])

--next
-main HookShims
--js build/js/hook-shims.js
--macro maux.ModuleLevel.strip(['HookShims'])

--next
-main Popup
--js build/js/popup.js
--macro maux.ModuleLevel.strip(['Popup'])
